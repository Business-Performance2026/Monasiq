rules_version = '2';
// قواعد حماية قاعدة البيانات — انسخها إلى: Firestore Database > Rules > Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function schoolDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data;
    }
    function isActiveSchool(schoolId) {
      return signedIn() && request.auth.uid == schoolId && schoolDoc(schoolId).status == 'active';
    }
    // معلم مفعّل تابع لهذه المدرسة (والمدرسة نفسها مفعّلة)
    function isActiveTeacherOf(schoolId) {
      let path = /databases/$(database)/documents/teacherAccounts/$(request.auth.uid);
      return signedIn() && exists(path)
        && get(path).data.schoolId == schoolId
        && get(path).data.status == 'active'
        && schoolDoc(schoolId).status == 'active';
    }

    // مدير المنصة: يُضاف يدويًا من لوحة Firebase فقط
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // قائمة المدارس المفعّلة (الاسم والمنطقة فقط) — تظهر للمعلم عند التسجيل
    match /publicSchools/{schoolId} {
      allow read: if true;
      allow create, update: if isAdmin() || isActiveSchool(schoolId);
      allow delete: if isAdmin();
    }

    // المدارس — رقم المدرسة = رقم حساب المسؤول (uid)
    match /schools/{schoolId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == schoolId) || isActiveTeacherOf(schoolId);

      allow create: if signedIn() && request.auth.uid == schoolId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdmin() || (
        isActiveSchool(schoolId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'region', 'wilayah', 'stages', 'principal', 'phone', 'settings', 'updatedAt'])
      );

      allow delete: if isAdmin();

      // بيانات المدرسة: المدرسة تقرأ وتكتب، والمعلم المفعّل يقرأ فقط
      match /{sub=**} {
        allow read: if isAdmin() || isActiveSchool(schoolId) || isActiveTeacherOf(schoolId);
        allow write: if isAdmin() || isActiveSchool(schoolId);
      }
    }

    // روابط جداول المعلمين المرسلة عبر واتساب: تُقرأ بالرابط فقط (بدون قائمة)
    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if isActiveSchool(request.resource.data.schoolId);
      allow update: if isActiveSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isAdmin() || isActiveSchool(resource.data.schoolId);
    }

    // حسابات المعلمين — رقم الوثيقة = رقم حساب المعلم (uid)
    match /teacherAccounts/{uid} {
      // المعلم يرى حسابه، والمدرسة ترى حسابات معلميها، والمدير يرى الكل
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || (signedIn() && resource.data.schoolId == request.auth.uid);

      // طلب انضمام: المعلم ينشئ حسابه بحالة "بانتظار الموافقة" لمدرسة مفعّلة
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/publicSchools/$(request.resource.data.schoolId))
        && !request.resource.data.keys().hasAny(['teacherId']);

      // المدرسة: موافقة / إيقاف / تعديل / ربط بالجدول (لا تنقل المعلم لمدرسة أخرى)
      // المعلم: يعدّل اسمه وهاتفه فقط
      allow update: if isAdmin()
        || (isActiveSchool(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.status in ['pending', 'active', 'suspended'])
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']));

      // المدرسة تحذف (رفض أو حذف)، والمعلم يمكنه سحب طلبه
      allow delete: if isAdmin()
        || isActiveSchool(resource.data.schoolId)
        || (signedIn() && request.auth.uid == uid && resource.data.status == 'pending');
    }
  }
}
