rules_version = '2';
// قواعد حماية قاعدة البيانات — انسخها إلى: Firestore Database > Rules > Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function schoolDoc(schoolId) {
      return get(/databases/$(database)/documents/schools/$(schoolId)).data;
    }
    function isActiveSchool(schoolId) {
      return signedIn() && request.auth.uid == schoolId && schoolDoc(schoolId).status == 'active';
    }
    // الاشتراك: مدرسة مشتركة أو في فترتها التجريبية (أو مدرسة قديمة لم تبدأ تجربتها بعد)
    function subOk(schoolId) {
      let s = schoolDoc(schoolId);
      return !('trialEnds' in s) && !('paidUntil' in s)
        || s.get('trialEnds', 0) > request.time.toMillis()
        || s.get('paidUntil', 0) > request.time.toMillis();
    }
    function canEdit(schoolId) { return isActiveSchool(schoolId) && subOk(schoolId); }
    // معلم مفعّل تابع لهذه المدرسة (والمدرسة نفسها مفعّلة)
    function isActiveTeacherOf(schoolId) {
      let path = /databases/$(database)/documents/teacherAccounts/$(request.auth.uid);
      return signedIn() && exists(path)
        && get(path).data.schoolId == schoolId
        && get(path).data.status == 'active'
        && schoolDoc(schoolId).status == 'active';
    }

    // مدير المنصة: يُضاف يدويًا من لوحة Firebase فقط
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // قائمة المدارس المفعّلة (الاسم والمنطقة فقط) — تظهر للمعلم عند التسجيل
    match /publicSchools/{schoolId} {
      allow read: if true;
      allow create, update: if isAdmin() || isActiveSchool(schoolId);
      allow delete: if isAdmin();
    }

    // المدارس — رقم المدرسة = رقم حساب المسؤول (uid)
    match /schools/{schoolId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == schoolId) || isActiveTeacherOf(schoolId);

      allow create: if signedIn() && request.auth.uid == schoolId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';

      // المدرسة تعدّل بياناتها فقط (لا تستطيع تعديل الحالة أو الاشتراك)
      allow update: if isAdmin() || (
        canEdit(schoolId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'region', 'wilayah', 'stages', 'principal', 'phone', 'settings', 'updatedAt'])
      );

      allow delete: if isAdmin();

      // بيانات المدرسة: المدرسة تقرأ وتكتب (إذا كان اشتراكها ساريًا)، والمعلم المفعّل يقرأ فقط
      match /{sub=**} {
        allow read: if isAdmin() || isActiveSchool(schoolId) || isActiveTeacherOf(schoolId);
        allow write: if isAdmin() || canEdit(schoolId);
      }
      // رابط واتساب للمعلم يعمل حتى بعد انتهاء الاشتراك
      match /teachers/{tid} {
        allow update: if isActiveSchool(schoolId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shareId']);
      }
      // إشعارات المدرسة: الإدارة تنشئها، والمدرسة تقرؤها وتعلّمها كمقروءة
      match /notifications/{nid} {
        allow read: if isAdmin() || isActiveSchool(schoolId);
        allow create, delete: if isAdmin();
        allow update: if isAdmin() || (isActiveSchool(schoolId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      }
    }

    // أجهزة إشعارات الجوال: كل مستخدم يسجّل أجهزته فقط (السيرفر يرسل الإشعارات)
    match /pushTokens/{id} {
      allow read, delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.role in ['admin', 'school', 'teacher']
        && (request.resource.data.role != 'admin' || isAdmin())
        && (request.resource.data.role != 'school' || request.resource.data.schoolId == request.auth.uid)
        && (request.resource.data.role != 'teacher' || exists(/databases/$(database)/documents/teacherAccounts/$(request.auth.uid)));
    }

    // إعدادات الاشتراك (السعر، رقم التحويل...) — يقرؤها أي مستخدم مسجّل، ويعدّلها المدير
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // طلبات الاشتراك (وصل التحويل): المدرسة ترسل وتلغي طلبها المعلّق، والمدير يراجع
    match /payments/{id} {
      allow read: if isAdmin() || (signedIn() && resource.data.schoolId == request.auth.uid);
      allow create: if isActiveSchool(request.resource.data.schoolId)
        && request.resource.data.status == 'pending'
        && request.resource.data.receipt is string
        && request.resource.data.receipt.size() < 900000
        && !request.resource.data.keys().hasAny(['decidedAt', 'reason']);
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && resource.data.schoolId == request.auth.uid && resource.data.status == 'pending');
    }

    // روابط جداول المعلمين المرسلة عبر واتساب: تُقرأ بالرابط فقط (بدون قائمة)
    match /shares/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if isActiveSchool(request.resource.data.schoolId);
      allow update: if isActiveSchool(resource.data.schoolId) && request.resource.data.schoolId == resource.data.schoolId;
      allow delete: if isAdmin() || isActiveSchool(resource.data.schoolId);
    }

    // حسابات المعلمين — رقم الوثيقة = رقم حساب المعلم (uid)
    match /teacherAccounts/{uid} {
      // المعلم يرى حسابه، والمدرسة ترى حسابات معلميها، والمدير يرى الكل
      allow read: if isAdmin()
        || (signedIn() && request.auth.uid == uid)
        || (signedIn() && resource.data.schoolId == request.auth.uid);

      // طلب انضمام: المعلم ينشئ حسابه بحالة "بانتظار الموافقة" لمدرسة مفعّلة
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.status == 'pending'
        && exists(/databases/$(database)/documents/publicSchools/$(request.resource.data.schoolId))
        && !request.resource.data.keys().hasAny(['teacherId']);

      // المدرسة: موافقة / إيقاف / تعديل / ربط بالجدول (لا تنقل المعلم لمدرسة أخرى)
      // المعلم: يعدّل اسمه وهاتفه فقط
      allow update: if isAdmin()
        || (isActiveSchool(resource.data.schoolId)
            && request.resource.data.schoolId == resource.data.schoolId
            && request.resource.data.status in ['pending', 'active', 'suspended'])
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'updatedAt']));

      // المدرسة تحذف (رفض أو حذف)، والمعلم يمكنه سحب طلبه
      allow delete: if isAdmin()
        || isActiveSchool(resource.data.schoolId)
        || (signedIn() && request.auth.uid == uid && resource.data.status == 'pending');

      // إشعارات المعلم (تحديث الجدول): ينشئها السيرفر، والمعلم يقرأ ويعلّم كمقروء
      match /notifications/{nid} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
        allow create, delete: if isAdmin();
      }
    }
  }
}
